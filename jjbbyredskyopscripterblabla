local function getScroller()
    local playerGui = player:FindFirstChild("PlayerGui")
    if not playerGui then return nil end
    
    local topbarClipped = playerGui:FindFirstChild("TopbarStandardClipped")
    if topbarClipped then
        for _, desc in ipairs(topbarClipped:GetDescendants()) do
            if desc.Name == "DropdownScroller" then
                return desc
            end
        end
    end
    return nil
end

local function getOriginalIcon(scroller, displayName)
    for _, widget in ipairs(scroller:GetChildren()) do
        if widget.Name == "Widget" or widget.Name:match("Widget") then
            local isTarget = false
            local foundIcon = nil
            
            for _, desc in ipairs(widget:GetDescendants()) do
                if (desc:IsA("TextLabel") or desc:IsA("TextButton")) and desc.Text == displayName then
                    isTarget = true
                end
                if (desc:IsA("ImageLabel") or desc:IsA("ImageButton")) and desc.Image ~= "" then
                    foundIcon = desc.Image
                end
            end
            
            if isTarget and foundIcon then
                return foundIcon
            end
        end
    end
    return nil
end

