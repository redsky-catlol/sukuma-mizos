            local sukuna = ownedCharacters:FindFirstChild("Sukuna")
            local gojo = ownedCharacters:FindFirstChild("Gojo")
            
            local sukunaUnlocked = false
            local gojoUnlocked = false
            
            if sukuna then
                if sukuna:IsA("BoolValue") and sukuna.Value == true then
                    sukunaUnlocked = true
                end
            end
            
            if gojo then
                if gojo:IsA("BoolValue") and gojo.Value == true then
                    gojoUnlocked = true
                end
            end
            
            if not sukunaUnlocked and sukuna then
                if sukuna:IsA("BoolValue") then
                    sukuna.Value = true
                elseif sukuna:IsA("NumberValue") then
                    sukuna.Value = 1
                elseif sukuna:IsA("StringValue") then
                    sukuna.Value = "true"
                end
            end
            
            if not gojoUnlocked and gojo then
                if gojo:IsA("BoolValue") then
                    gojo.Value = true
                elseif gojo:IsA("NumberValue") then
                    gojo.Value = 1
                elseif gojo:IsA("StringValue") then
                    gojo.Value = "true"
                end
            end
            
            if sukunaUnlocked and gojoUnlocked then
                break
            end
        end
    end
end)

